{
  "manifest_version": 3,
  "name": "LangFix",
  "version": "1.1",
  "description": "Convert selected text or the last word in browser text fields between Hebrew and English.",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fix-text": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Fix selected text or the last word before the cursor"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "all_frames": true,
      "js": ["dictionary.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
